<section class="news_main mt-5 pt-5">
    <div class="container">
        <div class="news_text col-12">
            <h2 class="titel text-white">عضویت در خبرنامه</h2>
        </div>
        <form class="col-12 p-0">
            <label class="p-1 col-12 col-md-6 col-lg-3">
                <span>نام و نام خانوادگی : </span>
                <input  class="full-name-js"  name='NameSms'  id='NameSms' type="text" placeholder="نام">
            </label>
            <label class="p-1 col-12 col-md-6 col-lg-3">
                <span>پست الکترونیکی : </span>
                <input  class="email-js"  name="EmailSms" id="EmailSms" type="email" placeholder="ایمیل">
            </label>
            <label class="p-1 col-12 col-md-6 col-lg-3">
                <span>شماره موبایل : </span>
                <input class="mobile-js"  name="CellSms" id="CellSms"  type="text" placeholder="موبایل">
            </label>
            <div class="p-1 col-6 col-lg-3 mb-2-5 mt-auto">
                <a  onclick="submitNewsLetter()"  href="javascript:" class="button"> ثبت </a>
            </div>
        </form>
    </div>
</section>

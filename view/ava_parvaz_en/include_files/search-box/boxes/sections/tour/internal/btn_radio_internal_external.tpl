<div class="w-100 d-ceckboxs">
    <div class='cntr'>
        <div class="switch">
            <input autocomplete="off"
                   type="radio"
                   class="switch-input switch-input-tour-js"
                   name="btn_switch_tour"
                   value="1"
                   id="btn_switch_tour_international">
            <label for="btn_switch_tour_international"
                   class="switch-label switch-label-on justify-content-center">
                ##Foreign##
            </label>

            <input autocomplete="off"
                   type="radio"
                   class="switch-input switch-input-tour-js"
                   name="btn_switch_tour"
                   value="2"
                   checked
                   id="btn_switch_tour_internal">
            <label for="btn_switch_tour_internal"
                   class="switch-label switch-label-off justify-content-center">
                ##Internal##
            </label>
            <span class="switch-selection"></span>
        </div>
    </div>
</div>